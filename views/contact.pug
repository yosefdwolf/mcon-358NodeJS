extends layout

block content
  h2 Contact Us
  p Questions, feedback, or a chore dispute you need us to mediate? Send us a note below.

  if errors && errors.length
    .msg-error
      strong Please fix the following:
      ul
        each error in errors
          li= error

  form.contact-form(method="POST" action="/contact")
    .form-group
      label(for="name") Name
      input(type="text" id="name" name="name" value=old.name required)
    .form-group
      label(for="email") Email Address
      input(type="email" id="email" name="email" value=old.email required)
    .form-group
      label(for="subject") Subject
      input(type="text" id="subject" name="subject" value=old.subject required)
    .form-group
      label(for="message") Message
      textarea(id="message" name="message" rows="6" required)= old.message
    button.btn(type="submit") Send Message
